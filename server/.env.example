# RTG API configuration — copy to .env and fill in.
# Every value here works identically on AWS and on a cPanel Node.js app.

PORT=4000
# Public origin of the frontend (CORS + Chapa return URLs)
SITE_ORIGIN=http://localhost:5173
# Public origin of this API (Chapa callback URL)
API_ORIGIN=http://localhost:4000

# MySQL — RDS on AWS now; cPanel MySQL later (same driver)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rtg
DB_PASSWORD=change-me
DB_NAME=rtg_cms

# Auth
JWT_SECRET=generate-a-long-random-string
# Initial admin (created by `npm run seed`)
ADMIN_EMAIL=info@rtgeth.org
ADMIN_PASSWORD=change-me-immediately

# Chapa — PENDING: fill with RTG's real keys once the account is created.
# Test keys (CHASECK_TEST-...) work end-to-end against Chapa's sandbox.
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: set in the Chapa dashboard, used to verify webhook signatures
CHAPA_WEBHOOK_SECRET=

# Uploads: "local" stores under server/uploads (works on cPanel).
# Set S3_BUCKET + STORAGE_DRIVER=s3 later only if we stay on AWS.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
