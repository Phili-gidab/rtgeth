#!/bin/bash
# RTG web bootstrap — Ubuntu 24.04 Lightsail.
# Builds the same stack a cPanel host provides: nginx + Node app + MariaDB.
set -euxo pipefail
exec > /var/log/rtg-bootstrap.log 2>&1

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y nginx mariadb-server git curl

# Node 20 (NodeSource) + pm2
curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
apt-get install -y nodejs
npm install -g pm2

# ---- database ----
systemctl enable --now mariadb
mysql -e "CREATE DATABASE IF NOT EXISTS rtg_cms CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
mysql -e "CREATE USER IF NOT EXISTS 'rtg'@'localhost' IDENTIFIED BY '${db_password}';"
mysql -e "GRANT ALL PRIVILEGES ON rtg_cms.* TO 'rtg'@'localhost'; FLUSH PRIVILEGES;"

# ---- app ----
mkdir -p /opt/rtg
git clone ${repo_url} /opt/rtg || (cd /opt/rtg && git pull)
cd /opt/rtg

# frontend build (VITE_API_URL empty: same-origin via nginx)
npm ci
npm run build
mkdir -p /var/www/rtg
cp -r dist/* /var/www/rtg/

# API
cd server
npm ci --omit=dev
cat > .env <<EOF
PORT=4000
SITE_ORIGIN=https://${site_domain},http://${site_domain}
API_ORIGIN=https://${site_domain}
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rtg
DB_PASSWORD=${db_password}
DB_NAME=rtg_cms
JWT_SECRET=${jwt_secret}
ADMIN_EMAIL=${admin_email}
ADMIN_PASSWORD=CHANGE-ME-ON-FIRST-LOGIN
CHAPA_SECRET_KEY=CHASECK_TEST-PENDING-RTG-ACCOUNT
CHAPA_WEBHOOK_SECRET=
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
EOF
npm run migrate
npm run seed
pm2 start src/index.js --name rtg-api
pm2 save
pm2 startup systemd -u root --hp /root | tail -1 | bash || true

# ---- nginx ----
cat > /etc/nginx/sites-available/rtg <<'NGINX'
server {
    listen 80 default_server;
    server_name ${site_domain} www.${site_domain} _;

    root /var/www/rtg;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 10m;
    }
    location /uploads/ {
        proxy_pass http://127.0.0.1:4000;
        expires 30d;
    }
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location / {
        try_files $uri /index.html;   # SPA fallback (/, /admin, /donate/thanks)
    }
}
NGINX
rm -f /etc/nginx/sites-enabled/default
ln -sf /etc/nginx/sites-available/rtg /etc/nginx/sites-enabled/rtg
nginx -t && systemctl reload nginx

# TLS is interactive-ish (needs DNS pointed first): install certbot, run manually later
apt-get install -y certbot python3-certbot-nginx

echo "RTG bootstrap complete"
