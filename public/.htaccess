# RTG website — Apache/cPanel config (copied into dist/ by Vite).
# /api/* → PHP front controller (the CMS backend runs on this same host).
# SPA fallback: real files are served, everything else routes to index.html
# so /admin and /donate/thanks work on refresh and deep links.

RewriteEngine On
RewriteBase /

# Apache strips the Authorization header for CGI/FPM PHP — re-export it
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# API → PHP (must come before the SPA fallback)
RewriteRule ^api(/.*)?$ api/index.php [L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.html [L]

# Cache hashed assets aggressively
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|jpg|png|webp|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
